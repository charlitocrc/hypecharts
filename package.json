{
  "name": "hypecharts",
  "version": "0.1.0",
  "description": "Open-source crypto charting built on KLineChart — 60 indicators, 59 drawing tools, live Hyperliquid/Binance datafeeds, no license fees.",
  "type": "module",
  "main": "./dist/klinecharts-pro.umd.js",
  "module": "./dist/klinecharts-pro.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlitocrc/hypecharts.git"
  },
  "keywords": [
    "hypecharts",
    "candlestick",
    "crypto",
    "finance",
    "trading-charts",
    "chart",
    "charts",
    "tradingview",
    "klinecharts",
    "canvas"

  ],
  "author": "liihuu",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "demo": "vite --config vite.config.demo.ts --force",
    "test": "vitest run --environment node",
    "build-core": "tsc && vite build",
    "build-dts": "dts-bundle-generator --no-banner true --umd-module-name klinechartspro -o dist/index.d.ts src/index.ts",
    "build": "npm run build-core && npm run build-dts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "docs:dev": "vitepress dev docs/site",
    "docs:build": "vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site",
    "docs:deploy": "npm run docs:build && gh-pages -d docs/site/.vitepress/dist"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.6.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/lodash": "^4.14.191",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "babel-preset-solid": "^1.6.10",
    "dts-bundle-generator": "^7.2.0",
    "esbuild": "^0.17.18",
    "eslint": "^8.35.0",
    "eslint-config-standard-with-typescript": "^34.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "gh-pages": "^5.0.0",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "playwright": "^1.64.1",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vite-plugin-solid": "^2.6.1",
    "vitepress": "^1.0.0-alpha.75",
    "vitest": "^0.28.4",
    "klinecharts": "file:vendor"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "solid-js": "^1.6.11"
  },
  "homepage": "https://github.com/charlitocrc/hypecharts#readme",
  "engines": {
    "node": ">=18"
  }
}
